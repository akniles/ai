#!/bin/bash
# Install a reviewed host-owned copy outside the fetched object store.
set -euo pipefail
umask 077
export PATH=/usr/bin:/bin HOME=/var/lib/ai-pull-deploy GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0
state=/var/lib/ai-pull-deploy
repo=$state/source.git
site=/opt/ai/.local/https/acme/ai-poc
origin=https://github.com/akniles/ai.git
exec 9>"$state/deploy.lock"
flock -n 9 || exit 0
[[ -d $site && ! -L $site ]]
[[ -d $repo ]] || git init --bare "$repo"
g() { git --git-dir="$repo" -c core.hooksPath=/dev/null -c protocol.allow=never -c protocol.https.allow=always "$@"; }
g -c http.followRedirects=false fetch --no-tags --depth=1 "$origin" +refs/heads/main:refs/heads/candidate
sha=$(g rev-parse --verify 'refs/heads/candidate^{commit}')
[[ $sha =~ ^[a-f0-9]{40}$ ]]

# Each release is prepared in full before changing the one symlink readers use.
# Git supplies data files only, never tools or server configuration.
publish() (
  local root=$1 prefix=$2 revision=$3 label=$4
  shift 4
  local release=$root/releases/$revision tmp= linkstage= asset file entry size
  [[ $revision =~ ^[a-f0-9]{40}$ ]]
  [[ -d $root && ! -L $root && -d $root/releases && ! -L $root/releases ]]
  if [[ $(readlink "$root/current" || true) == "releases/$revision" ]]; then exit 0; fi
  trap 'if [[ -n $tmp ]]; then rm -f -- "$tmp"/{index.html,app.js,style.css,preview.json,health.json,activity.js,chat.css,chat.js,trace.js,ui.js}; rmdir -- "$tmp"; fi; if [[ -n $linkstage ]]; then rm -f -- "$linkstage/current"; rmdir -- "$linkstage"; fi' EXIT
  if [[ ! -e $release ]]; then
    tmp=$(mktemp -d "$root/releases/.candidate.XXXXXXXX")
    for asset in "$@"; do
      file=$prefix/$asset
      entry=$(g ls-tree "$sha" -- "$file")
      [[ $entry == "100644 blob "* || $entry == "100755 blob "* ]]
      size=$(g cat-file -s "$sha:$file")
      [[ $size -gt 0 && $size -le 1048576 ]]
      g cat-file blob "$sha:$file" > "$tmp/$asset"
      chmod 0644 "$tmp/$asset"
    done
    printf '{"ok":true,"commit":"%s"}\n' "$sha" > "$tmp/health.json"
    chmod 0644 "$tmp/health.json"
    chmod 0755 "$tmp"
    mv -T -- "$tmp" "$release"
    tmp=
  fi
  [[ -d $release && ! -L $release ]]
  for file in "$@" health.json; do [[ -f $release/$file && ! -L $release/$file ]]; done
  linkstage=$(mktemp -d "$root/.pointer.XXXXXXXX")
  ln -s "releases/$revision" "$linkstage/current"
  mv -Tf -- "$linkstage/current" "$root/current"
  printf 'Serving %s commit %s (%s)\n' "$label" "$sha" "$revision"
)

publish "$site" web "$sha" "static preview" index.html app.js style.css preview.json
# Bootstrap the bind mount on the server once; leave live unchanged for old commits.
if [[ -d $site/live ]] && live_tree=$(g rev-parse --verify "$sha:live-web" 2>/dev/null); then
  [[ $(g cat-file -t "$live_tree") == tree ]]
  publish "$site/live" live-web "$live_tree" "live frontend" index.html app.js style.css activity.js chat.js ui.js chat.css trace.js
fi
